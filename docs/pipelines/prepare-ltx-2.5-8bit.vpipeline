{
  "id": "prepare-ltx-2.5-8bit",
  "stages": [
    {
      "id": "fetch",
      "type": "model-fetch",
      "config": {
        "model_path": "Lightricks/LTX-2.5",
        "model_variant": "LTX-2.5-distilled",
        "hf_token": "",
        "base_path": "./models",
        "skip_existing_files": true,
        "overwrite_existing": false
      }
    },
    {
      "id": "quant-dit",
      "type": "model-quantize",
      "iports": [
        {
          "src": "fetch",
          "oport": 0
        }
      ],
      "config": {
        "src_model": "LTX-2.5-distilled",
        "output_name": "local/LTX-2.5-distilled-8bit-dit",
        "target": "dit",
        "bits": 8,
        "group_size": 64,
        "skip_existing": true
      }
    },
    {
      "id": "quant-encoder",
      "type": "model-quantize",
      "iports": [
        {
          "src": "quant-dit",
          "oport": 0
        }
      ],
      "config": {
        "src_model": "local/LTX-2.5-distilled-8bit-dit",
        "output_name": "local/LTX-2.5-distilled-8bit",
        "target": "text_encoder",
        "bits": 8,
        "group_size": 64,
        "skip_existing": true
      }
    },
    {
      "id": "remove-dit-intermediate",
      "type": "model-remove",
      "iports": [
        {
          "src": "quant-encoder",
          "oport": 0
        }
      ],
      "config": {
        "model": "local/LTX-2.5-distilled-8bit-dit",
        "delete_files": true,
        "missing_ok": true
      }
    }
  ]
}
